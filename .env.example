# ===== 必填 =====
# 你的域名（DNS 已解析到这台服务器）
DOMAIN=kb.example.com
# 登录密码（建议 12 位以上）
ADMIN_PASSWORD=change-me
# 会话签名密钥，必须有值，否则程序启动不了。deploy.sh 生成 .env 时会自动填；
# 自己准备好 .env 再上传时，用 openssl rand -hex 32 生成一个填上
SECRET_KEY=

# ===== AI（OpenAI 兼容接口，换服务商只改这三行）=====
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ===== 可选：识别截图和小红书配图文字的视觉模型（不填就用本地 OCR）=====
# 例：阿里云百炼 通义千问 VL（qwen-vl-max 在部分账号不可用，推荐 qwen3-vl-plus）
# VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VISION_API_KEY=sk-xxx
# VISION_MODEL=qwen3-vl-plus
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# ===== 备份 =====
# 每天几点备份（东八区，-1 关闭）；本地保留几份
BACKUP_HOUR=4
BACKUP_KEEP=14
# 可选：上传到阿里云 OSS（同地域可用内网 endpoint，如 https://oss-cn-hongkong-internal.aliyuncs.com）
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=kb-backup/

# 本地 http 调试时改成 0，线上保持 1
COOKIE_SECURE=1
